{
  "name": "full-stack-template",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "turbo dev --continue --filter @template/api --filter @template/mobile --filter @template/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "turbo format",
    "api:dev": "pnpm --filter @template/api start:local:dev",
    "api:build": "turbo build --filter @template/api",
    "api:test": "pnpm --filter @template/api test",
    "api:openapi": "turbo openapi:generate --filter @template/api",
    "api-client:generate": "pnpm --filter @template/api-client generate",
    "api-contract:generate": "pnpm api:openapi && pnpm api-client:generate",
    "mobile:dev": "pnpm --filter @template/mobile start",
    "web:dev": "pnpm --filter @template/web dev",
    "docs:list": "node scripts/docs/list.mjs",
    "docs:check": "node scripts/docs/check.mjs",
    "docs:test": "node --test 'scripts/docs/*.test.mjs'",
    "contract:check": "node scripts/api-contract-check.mjs",
    "ios": "pnpm --filter @template/mobile ios",
    "android": "pnpm --filter @template/mobile android"
  },
  "devDependencies": {
    "turbo": "^2.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@scarf/scarf",
      "esbuild",
      "lightningcss",
      "unrs-resolver"
    ]
  }
}
